@article{orr_1979,
  title             = {Ecology of the small spotted lizard (Eremias guttulata guttulata) in the Negev desert (Israel)},
  author            = {Orr, Y. and Shachak, M. and Steinberger, Y.},
  pages             = {151-161},
  url               = {https://linkinghub.elsevier.com/retrieve/pii/S0140196318317907},
  year              = {1979},
  month             = {jun},
  urldate           = {2020-09-02},
  journal           = {Journal of arid environments},
  volume            = {2},
  number            = {2},
  issn              = {01401963},
  doi               = {10.1016/S0140-1963(18)31790-7},
  sciwheel-projects = {insects\_and\_microclimate},
  abstract          = {The small spotted desert lizard (Eremias guttulata) is the most abundant reptile on rocky hills in the Negev and Sinai. A field study on a marked population shows: (1)E. guttulata has an annual life cycle which can be divided into three periods: (a) Growing period (net production 0·374–0·172 cal m−2 day−1), (b) maturation period (net production 0·072 cal m−2 day−1), (c) reproductive period (net production 0·087 cal m−2 day−1).(2)The active population is highest in the summer\textemdash24 lizards 1000m−2. Age group structure is simple, leading to a uniform age group most of the year.(3)Home ranges varied from 100 to 900 m2 lizard−1.It is hypothesized that the success of E. guttulata is determined by several small complementary morphological and behavioural adaptations. Success of this species in the stony desert microenvironment depends much on water and energy conservation, high fecundity and small body size.}
}
